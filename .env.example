# Template only. Copy this file to .env in the same folder and fill in your own values there.
# .env is git-ignored; this .env.example is committed, so never put real values here.

# SEC asks every program to identify itself: your name and an email you read.
SEC_USER_AGENT=Your Name your@email.com

# LLM providers (Phase 5). Leave empty until needed.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=            # not used for now
# Optional model overrides
ANTHROPIC_MODEL=claude-haiku-4-5
GEMINI_MODEL=gemini-3.8-flash

# Spending caps (DESIGN §11)
LLM_MONTHLY_BUDGET_USD=5
LAB_DAILY_BUDGET_USD=0.5
