[Unit]
Description=Investment Lab: install the newest GitHub release if there is one
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
# Runs as root on purpose: the script, the units and the docker socket are then not writable by the login user.
User=root
ExecStart=/opt/investment/bin/auto-deploy.sh
TimeoutStartSec=1200
